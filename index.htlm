<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cruciverba della cellula</title>
<style>
:root{--bg:#f7f6f2;--fg:#1f2421;--mut:#5d655f;--cell:#fff;--bd:#b9c0b8;--key:#fde9a8;--keyfg:#4a3600;--ok:#c8ecd0;--ko:#f6c9c9;--acc:#2f7d5b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#171b19;--fg:#e8ece9;--mut:#a3aca6;--cell:#232a26;--bd:#4a554e;--key:#6b5514;--keyfg:#fff3c7;--ok:#245a38;--ko:#6a2c2c;--acc:#5fc79a}}
:root[data-theme="dark"]{--bg:#171b19;--fg:#e8ece9;--mut:#a3aca6;--cell:#232a26;--bd:#4a554e;--key:#6b5514;--keyfg:#fff3c7;--ok:#245a38;--ko:#6a2c2c;--acc:#5fc79a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font-family:Georgia,"Times New Roman",serif;line-height:1.5}
main{max-width:640px;margin:0 auto;padding:20px 14px 40px}
h1{font-size:1.5rem;margin:0 0 4px}
p.sub{margin:0 0 16px;color:var(--mut);font-size:.95rem}
.grid{overflow-x:auto;padding-bottom:6px}
.row{display:flex;align-items:center;gap:3px;margin-bottom:3px;width:max-content}
.n{width:1.4rem;text-align:right;font-size:.75rem;color:var(--mut);padding-right:3px;font-family:system-ui,sans-serif}
.c{width:var(--s,32px);height:var(--s,32px);box-sizing:border-box;border:1px solid var(--bd);background:var(--cell);color:var(--fg);text-align:center;font:600 1rem system-ui,sans-serif;text-transform:uppercase;padding:0;border-radius:4px}
.c.key{background:var(--key);color:var(--keyfg);border-color:#c9a227}
.c.ok{background:var(--ok)}.c.ko{background:var(--ko)}
.c:focus{outline:2px solid var(--acc);outline-offset:0}
.keyword{margin:14px 0;font-family:system-ui,sans-serif;font-size:.9rem;color:var(--mut)}
.keyword b{letter-spacing:.25em;color:var(--fg);font-size:1.05rem}
.btns{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 18px}
button{font:500 .9rem system-ui,sans-serif;padding:8px 14px;border-radius:8px;border:1px solid var(--bd);background:var(--cell);color:var(--fg);cursor:pointer}
button.p{background:var(--acc);border-color:var(--acc);color:#fff}
ol{padding-left:0;list-style:none;margin:0}
li{margin-bottom:8px;font-size:.98rem;display:flex;gap:8px}
li span{color:var(--mut);min-width:1.4rem;text-align:right;font-family:system-ui,sans-serif;font-size:.85rem;padding-top:2px}
#msg{min-height:1.4em;font-family:system-ui,sans-serif;font-size:.9rem}
</style>
</head>
<body>
<main>
<h1>Cruciverba della cellula</h1>
<p class="sub">Scrivi le risposte in orizzontale. Le lettere iniziali (colonna gialla), lette dall’alto in basso, formano la parola nascosta.</p>
<div class="grid" id="grid"></div>
<div class="keyword">Parola nascosta: <b id="kw">___________</b></div>
<div class="btns">
<button class="p" id="chk">Controlla</button>
<button id="rev">Mostra soluzioni</button>
<button id="rst">Ricomincia</button>
</div>
<div id="msg"></div>
<h2 style="font-size:1.1rem;margin:18px 0 10px">Definizioni</h2>
<ol id="clues"></ol>
</main>
<script>
const W=[
["MITOCONDRIO","Organulo che produce ATP: la «centrale energetica» della cellula"],
["INTERFASE","Fase del ciclo cellulare compresa tra una divisione e la successiva"],
["CROMOSOMA","Struttura che contiene il DNA e diventa ben visibile durante la divisione"],
["RIBOSOMA","Organulo in cui avviene la sintesi delle proteine"],
["ORGANULO","Piccola struttura specializzata all’interno della cellula"],
["STAMINALE","Cellula indifferenziata capace di specializzarsi in tipi diversi"],
["CITOPLASMA","Sostanza gelatinosa che riempie la cellula attorno al nucleo"],
["OSMOSI","Passaggio di acqua attraverso una membrana semipermeabile"],
["PARETE","Rivestimento rigido esterno delle cellule vegetali"],
["ISTONI","Proteine attorno a cui si avvolge il DNA nel nucleo"],
["OVOCITA","Cellula uovo femminile"]
];
const g=document.getElementById('grid'),cl=document.getElementById('clues'),msg=document.getElementById('msg');
const L=11;document.documentElement.style.setProperty('--s','clamp(24px,6.6vw,34px)');
W.forEach((w,r)=>{
 const row=document.createElement('div');row.className='row';
 row.innerHTML='<span class="n">'+(r+1)+'</span>';
 for(let c=0;c<w[0].length;c++){
  const i=document.createElement('input');i.className='c'+(c===0?' key':'');
  i.maxLength=1;i.dataset.r=r;i.dataset.c=c;i.autocomplete='off';i.autocapitalize='characters';
  row.appendChild(i);
 }
 g.appendChild(row);
 const li=document.createElement('li');
 li.innerHTML='<span>'+(r+1)+'.</span><div>'+w[1]+' <small style="color:var(--mut)">('+w[0].length+')</small></div>';
 cl.appendChild(li);
});
const cell=(r,c)=>g.querySelector('[data-r="'+r+'"][data-c="'+c+'"]');
function kw(){document.getElementById('kw').textContent=W.map((w,r)=>(cell(r,0).value||'_').toUpperCase()).join('')}
g.addEventListener('input',e=>{
 const t=e.target;t.value=t.value.replace(/[^a-zA-ZàèéìòùÀ-Ü]/g,'').toUpperCase();
 t.classList.remove('ok','ko');
 if(t.value){const n=cell(+t.dataset.r,+t.dataset.c+1);if(n)n.focus()}
 kw();
});
g.addEventListener('keydown',e=>{
 const t=e.target,r=+t.dataset.r,c=+t.dataset.c;let n=null;
 if(e.key==='Backspace'&&!t.value)n=cell(r,c-1);
 else if(e.key==='ArrowLeft')n=cell(r,c-1);
 else if(e.key==='ArrowRight')n=cell(r,c+1);
 else if(e.key==='ArrowUp')n=cell(r-1,Math.min(c,W[r-1]?W[r-1][0].length-1:0));
 else if(e.key==='ArrowDown'&&r<W.length-1)n=cell(r+1,Math.min(c,W[r+1][0].length-1));
 if(n){e.preventDefault();n.focus();n.select()}
});
document.getElementById('chk').onclick=()=>{
 let ok=0,filled=0,tot=0;
 W.forEach((w,r)=>[...w[0]].forEach((ch,c)=>{
  const x=cell(r,c);tot++;x.classList.remove('ok','ko');
  if(x.value){filled++;if(x.value===ch){x.classList.add('ok');ok++}else x.classList.add('ko')}
 }));
 msg.textContent=ok===tot?'Complimenti! Hai completato il cruciverba: la parola nascosta è MICROSCOPIO.':ok+' lettere corrette su '+filled+' inserite.';
};
document.getElementById('rev').onclick=()=>{
 W.forEach((w,r)=>[...w[0]].forEach((ch,c)=>{const x=cell(r,c);x.value=ch;x.classList.remove('ko');x.classList.add('ok')}));
 kw();msg.textContent='Soluzioni mostrate.';
};
document.getElementById('rst').onclick=()=>{
 g.querySelectorAll('input').forEach(x=>{x.value='';x.classList.remove('ok','ko')});
 kw();msg.textContent='';cell(0,0).focus();
};
</script>
</body>
</html>
